# Server Configuration
ENV=development
HOST=0.0.0.0
PORT=8000

# Security & Authentication (Generate a strong secret key for production!)
JWT_SECRET=supersecretjwtkeyforlocaldevelopmentonlychangeinprod!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Configuration (Set your keys here!)
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Database connection details (Defaults to local Docker/host mappings)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=chatbot_memory

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Local SQLite Fallback settings (Allows running without active Mongo/Neo4j servers)
USE_LOCAL_FALLBACK=true
LOCAL_DB_PATH=data/local_fallback.db
CHROMA_DB_DIR=data/chroma_db
